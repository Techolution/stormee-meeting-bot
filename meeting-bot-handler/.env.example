# Handler configuration. Every value below is a default; set only what differs.

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Bot pod discovery ------------------------------------------------------
# In a cluster the handler lists bot pods and talks to them directly.
KUBERNETES_ENABLED=true
BOT_NAMESPACE=default
BOT_LABEL_SELECTOR=app.kubernetes.io/name=meeting-bot
BOT_POD_PORT=5000
BOT_API_PREFIX=/api/meet
# Out-of-cluster runs only; unset means in-cluster credentials, then ~/.kube/config.
# KUBECONFIG=/home/you/.kube/config

# --- Local development without a cluster ------------------------------------
# When set, every session is dispatched here instead of to a discovered pod.
# BOT_SERVICE_URL=http://localhost:5000

# --- Timeouts ---------------------------------------------------------------
BOT_REQUEST_TIMEOUT_SECONDS=30
BOT_PROBE_TIMEOUT_SECONDS=3
JOIN_POLL_INTERVAL_SECONDS=5
# Must exceed the bot's MEETING_ADMISSION_TIMEOUT_SECONDS.
JOIN_POLL_TIMEOUT_SECONDS=600

# --- Not yet used by the handler --------------------------------------------
REDIS_URL=redis://localhost:6379/0
