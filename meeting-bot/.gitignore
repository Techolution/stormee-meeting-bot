# --- Secrets and local configuration --------------------------------------
# A filled-in .env holds backend URLs and Redis credentials.
.env
.env.*
!.env.example

# Google session cookies. Committing this would hand over an authenticated
# session to anyone with repository access.
chrome_profile/
auth.json
*.credentials.json

# --- Meeting artefacts ----------------------------------------------------
# Recordings and transcripts belong in object storage, not in git.
*.webm
*.mp3
*.wav
*.docx
screenshots/
recordings/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

