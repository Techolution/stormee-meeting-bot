# Meeting bot configuration.
#
#   cp .env.example .env
#
# Only the variables under "Required" must be set. Everything else has a working
# default — see docs/CONFIGURATION.md for the full reference.
#
# Never commit a filled-in .env: it is listed in .gitignore for that reason.

# ==========================================================================
# Required
# ==========================================================================

# Creative Workspace backend. Recordings are uploaded and registered here.
CW_UTILS_URL=https://dev.appmod.ai

# Default project a recording is filed under when a join request omits projectId.
PROJECT_ID=
PROJECT_NAME=

# ==========================================================================
# Application
# ==========================================================================

# local | dev | qa | prod. Also sets the default log level: DEBUG locally, INFO elsewhere.
ENVIRONMENT=local

# Override the level explicitly if needed.
# LOG_LEVEL=DEBUG

# text for humans, json for log aggregators. Use json in dev/qa/prod.
LOG_FORMAT=text

APP_PORT=5000
# Comma-separated origins, or * to allow any. Narrow this in production.
CORS_ORIGINS=*

# ==========================================================================
# Audio service (optional)
# ==========================================================================

# Socket.IO endpoint of the separately deployed audio service. When set, audio is
# streamed there and that service owns object-storage ingest.
#
# Leave empty and the bot performs the resumable upload itself, which is the
# right choice for a standalone deployment.
WEBSOCKET_URL=

# WEBSOCKET_PATH=api/meet/socket.io
# WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5
# WEBSOCKET_RECONNECT_DELAY=1000
# WEBSOCKET_MAX_RECONNECT_DELAY=30000

# ==========================================================================
# Browser
# ==========================================================================

# false shows a real window. Useful when diagnosing a join; requires a display.
BROWSER_HEADLESS=true

# Chromium user-data directory. When it exists, the bot joins as the Google
# account signed in there; otherwise it joins as a guest and needs host admission.
# Populate it with: make auth-profile
BROWSER_PROFILE_DIR=chrome_profile

# Name the bot shows in the participant list.
BROWSER_GUEST_DISPLAY_NAME=Stormee.Ai

# Capture the page on join failures. Unset to disable.
# BROWSER_SCREENSHOT_DIR=/tmp/meeting-bot-screenshots

# ==========================================================================
# Meeting behaviour
# ==========================================================================

# How long to wait in the lobby for a host to admit the bot.
MEETING_ADMISSION_TIMEOUT_SECONDS=300

# How long the bot stays alone before leaving on its own. Guards against a bot
# occupying a pod indefinitely after everyone else has left.
MEETING_SOLO_GRACE_PERIOD_SECONDS=120

# Let participants drive the bot from the meeting chat ("stormee start recording").
MEETING_CHAT_COMMANDS_ENABLED=true
MEETING_CHAT_COMMAND_PREFIX=stormee

# ==========================================================================
# Recording
# ==========================================================================

# MediaRecorder timeslice: one chunk is emitted per interval.
RECORDING_CHUNK_DURATION_MS=5000

# websocket = stream to the audio service. direct = upload from this process.
# 'websocket' falls back to 'direct' automatically when WEBSOCKET_URL is unset.
RECORDING_UPLOAD_TRANSPORT=websocket

# Bound on audio held in memory while the audio service is unreachable. Beyond
# this the oldest chunks are dropped, which is preferable to an OOM kill that
# would lose the whole meeting.
RECORDING_QUEUE_MAX_CHUNKS=100
RECORDING_QUEUE_MAX_MEMORY_MB=10

# ==========================================================================
# Transcription
# ==========================================================================

# Only in-meeting captions are implemented today.
TRANSCRIPTION_PROVIDER=caption
TRANSCRIPTION_POLL_INTERVAL_SECONDS=1.0

# ==========================================================================
# Meeting-state persistence (optional)
# ==========================================================================

# Redis stores meeting lifecycle history so it survives the pod. Set to false,
# or leave Redis unreachable, and the bot keeps that history in memory instead —
# meetings still run either way.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_STATE_TTL_SECONDS=3600

# ==========================================================================
# Upstream Meeting API (optional)
# ==========================================================================

# When set, the bot posts status callbacks here as a meeting progresses.
MEETING_API_URL=

# ==========================================================================
# Notification mail (optional)
# ==========================================================================

MAIL_ENABLED=true

# Fallback attribution when a join request omits userName / userEmail.
DEFAULT_USER_NAME=Meeting Bot
DEFAULT_USER_EMAIL=no-reply@example.com
